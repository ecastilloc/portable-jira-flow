{
  // Copy relevant sections to ignored config.local.json or profiles.local/*.
  // Local overlays may contain private paths, internal URLs, credential handle
  // names, company-specific commands, and profile-pack reference routes.
  //
  // Do not commit real passwords, cookies, bearer values, customer data,
  // private URLs, or full local env-file contents.
  "schemaVersion": "1.0.0",
  "defaultProfile": "company-work",

  "profiles": {
    "company-work": {
      "displayName": "Company Work",
      "ticketPrefixes": ["ABC"],

      "jira": {
        "baseUrl": "https://jira.example.com",
        "credentialStorage": "envFile",
        "envFile": "~/.portable-jira-flow/example-jira.env",
        "emailEnv": "JIRA_EMAIL",
        "tokenEnv": "JIRA_API_TOKEN",
        "fields": [
          "summary",
          "description",
          "status",
          "priority",
          "issuetype",
          "labels",
          "components",
          "parent",
          "issuelinks",
          "comment",
          "attachment",
          "environment"
        ]
      },

      "repositories": [
        {
          "name": "app",
          "path": "~/work/app",
          "baseBranch": "main",
          "branchPrefix": "feature",
          "required": true,
          "commit": true
        },
        {
          "name": "ui",
          "path": "~/work/app-ui",
          "baseBranch": "main",
          "branchPrefix": "feature",
          "required": false,
          "commit": true
        }
      ],

      "gitIdentity": {
        "verifyBeforeCommit": true,
        "requiredEmailDomain": "company.example",
        "allowedEmailPatterns": ["*@company.example"]
      },

      "provider": {
        "name": "github",
        "scope": "ticketRepositories",
        "verifyBeforeRemotePushOrPr": true,
        "requiredAccountDomain": "company.example",
        "allowedRemoteHosts": ["github.com"],
        "allowedRemoteOwners": ["example-org"]
      },

      "workspaces": {
        "mode": "git-worktree",
        "reuseCanonicalPaths": false,
        "allowDuplicateTicketWorkspaces": false,
        "missingWorkspaceStrategy": "create-if-configured",
        "ticketWorkspaceRoot": "~/work/tickets",
        "ticketWorkspaceFormat": "{ticketKey}/{repoName}"
      },

      "artifacts": {
        "runsRoot": "~/work/.portable-jira-flow/runs",
        "runLayout": "ticket",
        "nonCommittable": true
      },

      "branching": {
        "nameFormat": "{branchPrefix}/{ticketKey}",
        "dirtyStrategy": "backup-branch",
        "existingBranchStrategy": "reuse",
        "prefixByTicketType": {
          "feature": "feature",
          "bug": "bugfix",
          "regression": "regression",
          "production-bug": "hotfix",
          "hotfix": "hotfix",
          "spike": "spike",
          "refactor": "refactor",
          "test-only": "test",
          "chore": "chore",
          // Same branch-per-type convention covers performance/optimization work;
          // point it at "feature" instead if you don't want a dedicated prefix.
          "performance": "performance",
          "unknown": "feature"
        }
      },

      // Optional parent/child behavior. Keep regular tickets standalone; only
      // relationship types listed below reuse a parent branch or workspace.
      "relationships": {
        "enabled": true,
        "relationshipTypes": ["standalone", "defect", "follow-up"],
        "defaultRelationshipType": "standalone",
        "relationshipTypeAliases": {
          "defect": ["Defect"],
          "follow-up": ["Follow-up"]
        },
        "detectParentFrom": ["fields.parent.key", "fields.parent.fields.key", "linkedTickets.parent"],
        "parentRequiredForTypes": ["defect"],
        "reuseParentWorkspaceForTypes": ["defect"],
        "reuseParentBranchForTypes": ["defect"],
        "branchOwnerTicketSource": "parent-for-defects",
        "workspaceOwnerTicketSource": "parent-for-defects",
        "fallbackWhenNoParent": "standalone-with-warning",
        "baseRefresh": {
          "enabled": true,
          "strategy": "merge",
          "remote": "origin",
          // Override this in your ignored local profile when your team uses a
          // release branch instead of main as the parent-branch refresh base.
          "baseBranch": "main",
          "fetchRemote": true,
          "runOnStartForTypes": ["defect"],
          "stopOnConflict": true
        },
        "safety": {
          "requireParentRunWhenAvailable": false,
          "requireBranchMatchesOwner": true,
          "requireWorkspaceMatchesOwner": true,
          "stopWhenParentBranchAttachedElsewhere": true
        }
      },

      // Ticket type classification is content-driven, never derived from the
      // ticket key prefix (see references/configuration.md#ticket-type-classification).
      // This is what lets a "TD-1223"-style endpoint-optimization ticket, or an
      // "ABC-9001" filed under a generic "Story" issue type, both resolve to the
      // "performance" canonical type from their summary/parent-epic wording.
      "ticketTypes": {
        "aliases": {
          "bug": ["Bug", "Defect"],
          "performance": ["Performance", "Optimization"]
        },
        "canonicalTypes": ["feature", "bug", "regression", "production-bug", "hotfix", "spike", "refactor", "test-only", "chore", "performance", "unknown"],
        "bugLikeTypes": ["bug", "regression", "production-bug", "hotfix"],
        "performanceLikeTypes": ["performance"],
        "performance": {
          "attemptLocalBaseline": true,
          "stopIfNoBaselineCommand": false,
          "metrics": ["responseTimeMs", "queryCount", "payloadBytes"],
          // Leave empty until you have a real SLO; comparison still reports raw
          // before/after numbers without failing a threshold.
          "regressionThresholds": {}
        },
        "typeOverrideFlags": {
          "--bug": "bug",
          "--performance": "performance"
        },
        "detection": {
          "primaryField": "fields.issuetype.name",
          "fieldsToConsider": ["fields.issuetype.name", "fields.summary", "fields.description", "fields.labels", "fields.components", "linkedTickets"],
          "secondarySignals": ["fields.labels", "fields.components"],
          "weakFallbackSignals": ["fields.summary"],
          // Weak-fallback keyword hints used only when issuetype/labels don't resolve a type.
          "keywordSignals": {
            "performance": ["optimize", "optimization", "slow", "latency", "timeout", "N+1"]
          },
          // Catches tickets filed under a themed parent epic (e.g. a shared
          // performance backlog) regardless of the ticket's own issue type.
          "parentSummaryKeywords": {
            "performance": ["Performance Backlog"]
          },
          "conflictBehavior": "unknown-with-open-question"
        }
      },

      "referenceFiles": {
        "ready:local": ["profiles.local/company/references/local-readiness.md"],
        "accept:stage": ["profiles.local/company/references/stage-acceptance.md"],
        "status": ["profiles.local/company/references/status-notes.md"]
      },

      "commands": [
        {
          "name": "unit-tests",
          "stage": "validation",
          "repo": "app",
          "command": "npm test -- --runInBand",
          "runner": "host",
          "workdir": "{selectedWorkspacePath}",
          "mutability": "read-only",
          "requiredForPublish": true,
          "artifacts": [],
          "nonCommittableArtifacts": ["coverage/", "test-results/"],
          "backupBeforeRun": false,
          "compareOnFailure": true
        },
        // Performance baseline/comparison commands are ordinary commands[] entries
        // tagged with the performanceBaseline/performanceComparison stage, exactly
        // like unit-tests is tagged "validation" above. {performanceTarget} is
        // substituted at runtime from optimization-plan.md's Target field (it
        // can't be hardcoded once, since it's different per ticket). Point
        // "command" at whatever this team actually uses -- curl timing, a load
        // test tool, or (for a bigger lift) a small script that also reads your
        // app's own profiler/APM data, the way profiles.local/<company>/scripts/
        // could hold a helper for that.
        {
          "name": "endpoint-baseline-timing",
          "stage": "performanceBaseline",
          "repo": "app",
          "command": "curl -w '%{time_total}\\n' -o /dev/null -s http://localhost:3000{performanceTarget}",
          "runner": "host",
          "workdir": "{selectedWorkspacePath}",
          "mutability": "read-only",
          "requiredForPublish": false,
          "artifacts": [],
          "nonCommittableArtifacts": [],
          "backupBeforeRun": false,
          "compareOnFailure": false
        },
        {
          "name": "endpoint-comparison-timing",
          "stage": "performanceComparison",
          "repo": "app",
          "command": "curl -w '%{time_total}\\n' -o /dev/null -s http://localhost:3000{performanceTarget}",
          "runner": "host",
          "workdir": "{selectedWorkspacePath}",
          "mutability": "read-only",
          "requiredForPublish": false,
          "artifacts": [],
          "nonCommittableArtifacts": [],
          "backupBeforeRun": false,
          "compareOnFailure": true
        }
      ],

      "environments": {
        "local": {
          "type": "local",
          "readOnlyByDefault": true,
          "baseUrls": ["http://localhost:3000"],
          "healthChecks": [
            {
              "name": "app-health",
              "description": "Example local read-only health check",
              "runner": "host",
              "command": "curl -fsS http://localhost:3000/health",
              "readOnly": true
            }
          ],
          "authRefreshCommand": null,
          "codePresenceCommands": [],
          "readOnlyDiscoveryCommands": [],
          "acceptanceCommands": []
        },
        "stage": {
          "type": "shared",
          "readOnlyByDefault": true,
          "baseUrls": ["https://stage.example.com"],
          "healthChecks": [
            {
              "name": "app-health",
              "description": "Example stage read-only health check",
              "runner": "host",
              "command": "curl -fsS https://stage.example.com/health",
              "readOnly": true
            }
          ],
          "authRefreshCommand": null,
          "codePresenceCommands": [],
          "readOnlyDiscoveryCommands": [],
          "acceptanceCommands": []
        }
      },

      "e2e": {
        "enabled": true,
        "mode": "isolated-playwright",
        "workspacePath": "~/work/app-e2e",
        "basePlaywrightConfig": "playwright.config.js",
        "defaultEnvironment": "local",
        "specDir": "tests",
        "specFilePattern": "{ticketKeyLower}-{shortSummary}.spec.ts",
        "runCommandTemplate": "npx playwright test {specPaths} --config {playwrightConfigPath} --output {evidenceOutputDir}",
        "createMissingTicketSpecs": true,
        "generatedSpecSource": "manual-validation-steps.md",
        "mapSpecsToAcceptanceCriteria": true,
        "commitGeneratedSpecs": false
      },

      "evidence": {
        "enabled": true,
        "storage": "central",
        "missingPolicy": "warn",
        "centralEvidenceRoot": "~/work/jira-flow-artifacts/evidence",
        "requireReproductionForTicketTypes": ["bug", "regression", "production-bug", "hotfix"],
        "mediaExtensions": ["webm", "mp4", "mov"],
        "playwright": {
          "generatedConfigPattern": "playwright-evidence-{evidencePhase}.config.cjs",
          "outputDirPattern": "{centralEvidenceRoot}/{ticketKey}/{evidencePhase}",
          "video": "on",
          "screenshot": "only-on-failure",
          "trace": "retain-on-failure"
        },
        "phaseCommandTemplates": {
          "reproduction": "npx playwright test {specPaths} --config {playwrightConfigPath} --output {evidenceOutputDir}",
          "verification": "npx playwright test {specPaths} --config {playwrightConfigPath} --output {evidenceOutputDir}"
        }
      },

      "commits": {
        "enabled": true,
        "messageFormat": "{ticketKey}: {summary}",
        "oneCommitPerRepo": true,
        "skipIfNoChanges": true
      },

      "publishing": {
        "enabled": true,
        "provider": "github",
        "defaultDraft": true,
        "requireExplicitPublishFlag": true,
        "publishFlag": "--publish-draft-mr",
        "requireLocalPipelineGateBeforeCreate": true,
        "blockCreateOnGateFailure": true,
        "neverPushWithoutExplicitPublishRequest": true,
        "descriptionTemplate": "references/templates.md#mr-description.md",
        // Optional per-type override (see references/publishing.md#description-template-selection).
        "descriptionTemplateByTicketType": {
          "bug": "references/templates/mr-bug-description.md",
          "performance": "references/templates/mr-performance-description.md"
        },
        "descriptionTemplateFallback": "references/templates.md#mr-description.md"
      }
    }
  }
}
