{
  "schemaVersion": "1.0.0",
  "defaultProfile": "example",
  "invocation": {
    "normalizeUnicodeDashes": true,
    "primaryCommands": {
      "help": ["help"],
      "doctor": ["doctor"],
      "inspect": ["context", "classification", "reproductionHypothesis", "optimizationHypothesis", "readinessCheck", "plan"],
      "start": ["context", "classification", "reproductionHypothesis", "optimizationHypothesis", "readinessCheck", "plan", "prepareWorkspace", "reproductionEvidence", "performanceBaseline"],
      "implement": ["implementation"],
      "verify": ["validation", "manualValidation", "verificationEvidence", "performanceComparison"],
      "ready": ["environmentReadiness", "qaGuide"],
      "accept": ["environmentAcceptance"],
      "publish": ["prePublishValidation", "publishDraft"],
      "report": ["finalReport"],
      "status": ["status"],
      "cleanup": ["cleanup"]
    },
    "legacyAliases": {
      "analyze": "inspect",
      "a": "inspect",
      "--analyze": "inspect",
      "--context": "inspect",
      "--plan": "inspect",
      "--readiness-check": "inspect",
      "repro": "inspect",
      "r": "inspect",
      "--reproduce": "inspect",
      "branch": "start",
      "b": "start",
      "--branch": "start",
      "--prepare-branches": "start",
      "code": "implement",
      "c": "implement",
      "--code": "implement",
      "--implement": "implement",
      "check": "verify",
      "--check": "verify",
      "--validate": "verify",
      "manual-validation": "verify",
      "--manual-validation": "verify",
      "--capture-reproduction-evidence": "start",
      "--record-before": "start",
      "--capture-verification-evidence": "verify",
      "--record-after": "verify",
      "env-ready": "ready",
      "ready-for-testing": "ready",
      "--env-ready": "ready",
      "--ready-for-testing": "ready",
      "qa-guide": "ready",
      "validation-guide": "ready",
      "--qa-guide": "ready",
      "--validation-guide": "ready",
      "acceptance-validation": "accept",
      "--acceptance-validation": "accept",
      "pre-publish-validation": "publish",
      "publish-check": "publish",
      "--pre-publish-validation": "publish",
      "--publish-check": "publish",
      "complete": "report",
      "--complete": "report",
      "--final-report": "report",
      "abc": "start",
      "--abc": "start"
    },
    "explicitFlags": {
      "commit": ["commit", "--commit"],
      "noCommit": ["--no-commit"],
      "publishDraft": ["--publish-draft-mr", "--create-draft-pr", "--create-draft-mr"],
      "allowMutations": ["--allow-mutations"],
      "forceImplement": ["--force-implement"],
      "captureReproductionEvidence": ["--capture-reproduction-evidence", "--record-before"],
      "captureVerificationEvidence": ["--capture-verification-evidence", "--record-after"],
      "profile": "--profile",
      "fromBranch": "--from-branch",
      "parentTicket": ["--parent", "--parent-ticket"],
      "parentBranch": "--parent-branch",
      "useParentBranch": "--use-parent-branch",
      "noParentBranch": "--no-parent-branch",
      "cleanupApply": "--apply"
    }
  },
  "stageRegistry": {
    "help": {"command": "help", "legacyAliases": [], "readOnly": true, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": false, "writesArtifacts": []},
    "doctor": {"command": "doctor", "legacyAliases": [], "readOnly": true, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": false, "writesArtifacts": []},
    "context": {"command": "inspect", "legacyAliases": ["analyze", "--context"], "readOnly": true, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": false, "writesArtifacts": ["runState", "jira", "context", "relationshipMap"]},
    "classification": {"command": "inspect", "legacyAliases": ["analyze"], "readOnly": true, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": false, "writesArtifacts": ["classification"]},
    "reproductionHypothesis": {"command": "inspect", "legacyAliases": ["repro", "--reproduce"], "readOnly": true, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": false, "writesArtifacts": ["rootCause"]},
    "optimizationHypothesis": {"command": "inspect", "legacyAliases": [], "readOnly": true, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": false, "writesArtifacts": ["optimizationPlan"]},
    "readinessCheck": {"command": "inspect", "legacyAliases": ["--readiness-check"], "readOnly": true, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": false, "writesArtifacts": ["readiness", "blockers", "assumptions"]},
    "plan": {"command": "inspect", "legacyAliases": ["--plan"], "readOnly": true, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": false, "writesArtifacts": ["implementationPlan", "validationPlan"]},
    "prepareWorkspace": {"command": "start", "legacyAliases": ["branch", "--prepare-branches"], "readOnly": false, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": true, "writesArtifacts": ["repoMap", "workspaceMap", "relationshipMap", "baseRefresh", "baseSnapshot", "worktreeSafety"]},
    "reproductionEvidence": {"command": "start", "legacyAliases": ["--capture-reproduction-evidence", "--record-before"], "readOnly": false, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": false, "writesArtifacts": ["reproductionEvidence", "evidenceManifest", "playwrightEvidenceConfig", "reproductionVideo"]},
    "performanceBaseline": {"command": "start", "legacyAliases": [], "readOnly": false, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": false, "writesArtifacts": ["performanceBaseline"]},
    "implementation": {"command": "implement", "legacyAliases": ["code", "--implement"], "readOnly": false, "mayEditCode": true, "mayMutateEnvironment": false, "requiresExplicitUserIntent": true, "writesArtifacts": ["runState", "implementationPlan", "implementationSummary"]},
    "validation": {"command": "verify", "legacyAliases": ["check", "--validate"], "readOnly": false, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": true, "writesArtifacts": ["validationResults"]},
    "manualValidation": {"command": "verify", "legacyAliases": ["manual-validation", "--manual-validation"], "readOnly": false, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": true, "writesArtifacts": ["manualValidation"]},
    "verificationEvidence": {"command": "verify", "legacyAliases": ["--capture-verification-evidence", "--record-after"], "readOnly": false, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": false, "writesArtifacts": ["verificationEvidence", "evidenceManifest", "playwrightEvidenceConfig", "verificationVideo", "verificationScreenshot"]},
    "performanceComparison": {"command": "verify", "legacyAliases": [], "readOnly": false, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": false, "writesArtifacts": ["performanceComparison"]},
    "environmentReadiness": {"command": "ready", "legacyAliases": ["env-ready", "ready-for-testing"], "readOnly": true, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": true, "writesArtifacts": ["environmentReadiness"]},
    "qaGuide": {"command": "ready", "legacyAliases": ["qa-guide", "validation-guide"], "readOnly": true, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": true, "writesArtifacts": ["qaGuide", "qaGuideAllEnvs"]},
    "environmentAcceptance": {"command": "accept", "legacyAliases": ["acceptance-validation"], "readOnly": false, "mayEditCode": false, "mayMutateEnvironment": true, "requiresExplicitUserIntent": true, "writesArtifacts": ["environmentAcceptance", "verificationEvidence", "evidenceManifest", "verificationVideo", "verificationScreenshot"]},
    "prePublishValidation": {"command": "publish", "legacyAliases": ["pre-publish-validation", "publish-check"], "readOnly": false, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": true, "writesArtifacts": ["prePublishValidation", "qaVideo", "evidenceManifest"]},
    "publishDraft": {"command": "publish", "legacyAliases": ["--publish-draft-mr"], "readOnly": false, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": true, "writesArtifacts": ["mrDescription"]},
    "finalReport": {"command": "report", "legacyAliases": ["complete", "--final-report"], "readOnly": false, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": true, "writesArtifacts": ["definitionOfDone", "finalSummary", "artifactIndex"]},
    "status": {"command": "status", "legacyAliases": [], "readOnly": true, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": true, "writesArtifacts": []},
    "cleanup": {"command": "cleanup", "legacyAliases": [], "readOnly": false, "mayEditCode": false, "mayMutateEnvironment": false, "requiresExplicitUserIntent": true, "writesArtifacts": ["artifactIndex"]}
  },
  "artifactRegistry": {
    "runState": {"path": "run.json", "producer": "all", "consumers": ["all"], "sourceOfTruth": true, "derived": false, "userFacing": false, "privacyLevel": "private", "committable": false, "retention": "keep"},
