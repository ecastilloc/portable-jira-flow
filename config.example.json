    "verificationEvidence": {"path": "verification-evidence.md", "producer": "verify", "consumers": ["publish", "report", "status"], "sourceOfTruth": false, "derived": true, "userFacing": true, "privacyLevel": "private", "committable": false, "retention": "keep"},
    "performanceComparison": {"path": "performance-comparison.md", "producer": "verify", "consumers": ["publish", "report", "status"], "sourceOfTruth": false, "derived": true, "userFacing": true, "privacyLevel": "internal", "committable": false, "retention": "keep"},
