    "playwrightEvidenceConfig": {"path": "playwright-evidence-{evidencePhase}.config.cjs", "producer": "start", "consumers": ["verify", "accept", "publish", "report", "status"], "sourceOfTruth": false, "derived": true, "userFacing": false, "privacyLevel": "private", "committable": false, "retention": "keep"},
    "reproductionVideo": {"path": "{centralEvidenceRoot}/{ticketKey}/reproduction/reproduction-video-{ticketKey}.{ext}", "producer": "start", "consumers": ["verify", "publish", "report", "status"], "sourceOfTruth": false, "derived": false, "userFacing": true, "privacyLevel": "private", "committable": false, "retention": "manual-cleanup"},
    "verificationVideo": {"path": "{centralEvidenceRoot}/{ticketKey}/verification/verification-video-{ticketKey}.{ext}", "producer": "verify", "consumers": ["publish", "report", "status"], "sourceOfTruth": false, "derived": false, "userFacing": true, "privacyLevel": "private", "committable": false, "retention": "manual-cleanup"},
    "verificationScreenshot": {"path": "{centralEvidenceRoot}/{ticketKey}/verification/verification-screenshot-{ticketKey}.{ext}", "producer": "verify", "consumers": ["publish", "report", "status"], "sourceOfTruth": false, "derived": false, "userFacing": true, "privacyLevel": "private", "committable": false, "retention": "manual-cleanup"},
    "environmentReadiness": {"path": "environment-readiness-{environment}.md", "producer": "ready", "consumers": ["status", "report"], "sourceOfTruth": false, "derived": true, "userFacing": true, "privacyLevel": "internal", "committable": false, "retention": "keep"},
    "qaGuide": {"path": "qa-validation-guide-{environment}.md", "producer": "ready", "consumers": ["accept", "report"], "sourceOfTruth": false, "derived": true, "userFacing": true, "privacyLevel": "internal", "committable": false, "retention": "keep"},
    "qaGuideAllEnvs": {"path": "qa-validation-guide-all-envs.md", "producer": "ready", "consumers": ["report"], "sourceOfTruth": false, "derived": true, "userFacing": true, "privacyLevel": "internal", "committable": false, "retention": "keep"},
    "environmentAcceptance": {"path": "environment-acceptance-{environment}.md", "producer": "accept", "consumers": ["report"], "sourceOfTruth": false, "derived": true, "userFacing": true, "privacyLevel": "private", "committable": false, "retention": "keep"},
    "prePublishValidation": {"path": "pre-publish-validation.md", "producer": "publish", "consumers": ["publish", "report"], "sourceOfTruth": false, "derived": true, "userFacing": true, "privacyLevel": "internal", "committable": false, "retention": "keep"},
    "qaVideo": {"path": "qa-validation-video-{ticketKey}.{ext}", "producer": "publish", "consumers": ["report"], "sourceOfTruth": false, "derived": false, "userFacing": true, "privacyLevel": "private", "committable": false, "retention": "manual-cleanup"},
