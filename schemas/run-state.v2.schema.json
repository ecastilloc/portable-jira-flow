{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/portable-jira-flow/run-state.v2.schema.json",
  "title": "Portable Jira Flow Run State V2",
  "type": "object",
  "required": ["schemaVersion", "skillName", "ticketKey", "workflowVersion", "createdAt", "updatedAt", "invocation", "stages", "policy", "behaviorSpec", "coverage", "provenance", "artifacts"],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "skillName": {"const": "portable-jira-flow-v2"},
    "ticketKey": {"type": "string"},
    "profile": {"type": ["string", "null"]},
    "workflowVersion": {"const": "v2"},
    "createdAt": {"type": "string"},
    "updatedAt": {"type": "string"},
    "invocation": {"type": "object"},
    "stages": {"type": "object"},
    "policy": {"type": "object"},
    "behaviorSpec": {"type": "object"},
    "coverage": {"type": "object"},
    "provenance": {"type": "object"},
    "artifacts": {"type": "array"}
  },
  "additionalProperties": true
}
