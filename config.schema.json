{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/portable-jira-flow/config.schema.json",
  "title": "Portable Jira Flow Config",
  "type": "object",
  "required": ["schemaVersion", "defaultProfile", "invocation", "stageRegistry", "artifactRegistry", "policy", "profiles"],
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^1\\."},
    "defaultProfile": {"type": ["string", "null"]},
    "invocation": {
      "type": "object",
      "required": ["primaryCommands", "legacyAliases", "explicitFlags"],
      "properties": {
        "normalizeUnicodeDashes": {"type": "boolean"},
        "primaryCommands": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "legacyAliases": {"type": "object", "additionalProperties": {"type": "string"}},
        "explicitFlags": {"type": "object"}
      }
    },
    "stageRegistry": {"type": "object", "additionalProperties": {"$ref": "#/$defs/stage"}},
    "artifactRegistry": {"type": "object", "additionalProperties": {"$ref": "#/$defs/artifact"}},
    "policy": {"type": "object"},
    "profiles": {"type": "object", "additionalProperties": {"$ref": "#/$defs/profile"}}
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["command", "legacyAliases", "readOnly", "mayEditCode", "mayMutateEnvironment", "requiresExplicitUserIntent", "writesArtifacts"],
      "properties": {
        "command": {"type": "string"},
        "legacyAliases": {"type": "array", "items": {"type": "string"}},
        "readOnly": {"type": "boolean"},
        "mayEditCode": {"type": "boolean"},
        "mayMutateEnvironment": {"type": "boolean"},
        "requiresExplicitUserIntent": {"type": "boolean"},
        "writesArtifacts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "artifact": {
      "type": "object",
      "required": ["path", "producer", "consumers", "sourceOfTruth", "derived", "userFacing", "privacyLevel", "committable", "retention"],
      "properties": {
        "path": {"type": "string"},
        "producer": {"type": "string"},
        "consumers": {"type": "array", "items": {"type": "string"}},
        "sourceOfTruth": {"type": "boolean"},
        "derived": {"type": "boolean"},
        "userFacing": {"type": "boolean"},
        "privacyLevel": {"enum": ["public", "internal", "private", "secret-redacted"]},
        "committable": {"type": "boolean"},
        "retention": {"enum": ["keep", "keep-latest", "expire", "manual-cleanup"]}
      }
    },
    "profile": {
      "type": "object",
      "required": ["displayName", "ticketPrefixes", "jira", "repositories", "workspaces"],
      "properties": {
        "displayName": {"type": "string"},
        "ticketPrefixes": {"type": "array", "items": {"type": "string"}},
        "jira": {"type": "object"},
        "repositories": {"type": "array", "items": {"type": "object"}},
        "gitIdentity": {"type": "object"},
        "provider": {"type": "object"},
        "workspaces": {"type": "object"},
        "artifacts": {"$ref": "#/$defs/profileArtifacts"},
        "branching": {"type": "object"},
        "relationships": {"$ref": "#/$defs/relationships"},
        "analysis": {"type": "object"},
        "ticketTypes": {"type": "object"},
        "commands": {"type": "array", "items": {"type": "object"}},
        "environments": {"type": "object"},
        "referenceFiles": {"type": "object"},
        "e2e": {"type": "object"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "commits": {"type": "object"},
        "publishing": {"type": "object"},
        "workflowV2": {"$ref": "#/$defs/workflowV2"}
      }
    },
    "profileArtifacts": {
      "type": "object",
      "properties": {
        "runsRoot": {"type": "string"},
        "legacyArchiveRoot": {"type": "string"},
        "migrationManifestRoot": {"type": "string"},
        "legacyImportPolicy": {"enum": ["archive-only", "disabled"]},
        "runLayout": {"enum": ["ticket", "source-ticket"]},
        "nonCommittable": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "relationships": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "relationshipTypes": {
          "type": "array",
          "items": {"enum": ["standalone", "defect", "follow-up"]}
        },
        "defaultRelationshipType": {"enum": ["standalone", "defect", "follow-up"]},
        "relationshipTypeAliases": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        },
        "detectParentFrom": {"type": "array", "items": {"type": "string"}},
        "parentRequiredForTypes": {"type": "array", "items": {"type": "string"}},
        "reuseParentWorkspaceForTypes": {"type": "array", "items": {"type": "string"}},
        "reuseParentBranchForTypes": {"type": "array", "items": {"type": "string"}},
        "branchOwnerTicketSource": {"enum": ["current", "parent", "parent-for-defects"]},
        "workspaceOwnerTicketSource": {"enum": ["current", "parent", "parent-for-defects"]},
        "fallbackWhenNoParent": {"enum": ["standalone", "standalone-with-warning", "blocked"]},
        "baseRefresh": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "strategy": {"enum": ["merge", "none"]},
            "remote": {"type": "string"},
            "baseBranch": {"type": "string"},
            "fetchRemote": {"type": "boolean"},
            "runOnStartForTypes": {"type": "array", "items": {"type": "string"}},
            "stopOnConflict": {"type": "boolean"}
          },
          "additionalProperties": true
        },
        "safety": {
          "type": "object",
          "properties": {
            "requireParentRunWhenAvailable": {"type": "boolean"},
            "requireBranchMatchesOwner": {"type": "boolean"},
            "requireWorkspaceMatchesOwner": {"type": "boolean"},
            "stopWhenParentBranchAttachedElsewhere": {"type": "boolean"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "storage": {"enum": ["central", "run", "custom"]},
        "missingPolicy": {"enum": ["warn", "block", "off"]},
        "centralEvidenceRoot": {"type": ["string", "null"]},
        "requireReproductionForTicketTypes": {"type": "array", "items": {"type": "string"}},
        "mediaExtensions": {"type": "array", "items": {"type": "string"}},
        "playwright": {"type": "object"},
        "phaseCommandTemplates": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "workflowV2": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "runNamespace": {"type": "string"},
        "behaviorSpecs": {
          "type": "object",
          "properties": {
            "draftMode": {"enum": ["local-run-artifact"]},
            "template": {"type": "string"},
            "durableStorage": {"enum": ["explicit-policy-only", "configured-durable-path"]}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
